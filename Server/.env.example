# ============================================================================
# ARCHIVO: .env.example
# DESCRIPCIÓN: Variables de entorno necesarias para ejecutar el servidor
# 
# ¿QUÉ HACER?
# 1. Copiar este archivo: cp .env.example .env
# 2. Editar .env con valores reales
# 3. NUNCA subir .env a control de versiones (ya está en .gitignore)
# ============================================================================

# ============================================================================
# BASE DE DATOS (MySQL)
# ============================================================================

# Host del servidor MySQL
# Para Docker local: localhost o 127.0.0.1
# Para servidor remoto: IP o dominio
DB_HOST=localhost

# Usuario de MySQL
DB_USER=root

# Contraseña del usuario (⚠️ CAMBIAR EN PRODUCCIÓN)
DB_PASSWORD=1234

# Nombre de la base de datos
DB_NAME=control-asistencia

# Puerto MySQL (por defecto 3306)
DB_PORT=3306

# ============================================================================
# AUTENTICACIÓN (JWT - JSON Web Tokens)
# ============================================================================

# Clave secreta para firmar JWTs
# ⚠️ CRÍTICO: Usar string largo y aleatorio (mínimo 32 caracteres)
# Generar: openssl rand -hex 32
# NO usar el valor por defecto en PRODUCCIÓN
SECRET_KEY=cambiar_por_una_clave_super_secreta_minimo_32_caracteres_usar_openssl_rand

# Algoritmo para firmar tokens (HS256, HS512, etc)
ALGORITHM=HS256

# Tiempo de expiración de token (en minutos)
# 1440 = 24 horas
# 60 = 1 hora
TOKEN_EXPIRE_MINUTES=1440

# ============================================================================
# SERVIDOR
# ============================================================================

# Host del servidor FastAPI
SERVER_HOST=0.0.0.0

# Puerto del servidor
SERVER_PORT=8000

# Modo debug (True/False)
DEBUG=False

# ============================================================================
# CERTIFICADOS SSL/TLS (opcional)
# ============================================================================

# Ruta a certificado SSL (dejar vacío si no se usa HTTPS)
# Ejemplo: ./keys/cert_https.pem
SSL_CERT_PATH=

# Ruta a clave privada SSL (dejar vacío si no se usa HTTPS)
# Ejemplo: ./keys/key_https.pem
SSL_KEY_PATH=

# ============================================================================
# CREDENCIALES DISPOSITIVOS (ESP32)
# ============================================================================

# Contraseña para autenticación de dispositivos ESP32
# Usar un valor seguro diferente a DB_PASSWORD
DEVICE_PASSWORD=device_secret_super_seguro_cambiar_en_produccion

# ============================================================================
# LOGGING
# ============================================================================

# Nivel de log: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Ruta para guardar logs (opcional)
LOG_FILE=./logs/app.log

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================

# Dominios permitidos para solicitudes CORS (separar por coma)
# Ejemplo: http://localhost:3000,https://tudominio.com
CORS_ORIGINS=*

# ============================================================================
# AMBIENTE
# ============================================================================

# development, staging, production
ENVIRONMENT=development
